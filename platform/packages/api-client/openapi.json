{
  "components": {
    "schemas": {
      "CheckoutBody": {
        "properties": {
          "couple": {
            "additionalProperties": false,
            "properties": {
              "first": {
                "maxLength": 100,
                "minLength": 1,
                "type": "string"
              },
              "second": {
                "maxLength": 100,
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "first",
              "second"
            ],
            "type": "object",
            "x-nestjs_zod-parent-additional-properties": false,
            "x-nestjs_zod-self-required": true
          },
          "couponCode": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string",
            "x-nestjs_zod-parent-additional-properties": false
          },
          "eventDate": {
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
            "type": "string",
            "x-nestjs_zod-parent-additional-properties": false
          },
          "kind": {
            "enum": [
              "new",
              "extension",
              "edits"
            ],
            "type": "string",
            "x-nestjs_zod-parent-additional-properties": false
          },
          "method": {
            "enum": [
              "card",
              "wallet",
              "fawry"
            ],
            "type": "string",
            "x-nestjs_zod-parent-additional-properties": false
          },
          "pointsToRedeem": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer",
            "x-nestjs_zod-parent-additional-properties": false
          },
          "templateSlug": {
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "type": "string",
            "x-nestjs_zod-parent-additional-properties": false
          },
          "tier": {
            "enum": [
              "save-the-date",
              "classic",
              "premium"
            ],
            "type": "string",
            "x-nestjs_zod-parent-additional-properties": false
          }
        },
        "required": [
          "templateSlug",
          "tier",
          "kind",
          "method",
          "couple",
          "eventDate"
        ],
        "type": "object"
      },
      "UpdateMeBody": {
        "properties": {
          "locale": {
            "enum": [
              "ar",
              "en"
            ],
            "type": "string",
            "x-nestjs_zod-parent-additional-properties": false
          }
        },
        "required": [
          "locale"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
