{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // tsup's DTS worker cannot run with `incremental` (TS5074); the package
    // is tiny so no incremental cache is needed.
    "incremental": false
  },
  "include": [
    "src/**/*.ts",
    "vitest.config.ts",
    "tsup.config.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
