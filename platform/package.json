{
  "name": "invitation-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @platform/web",
    "build": "npm run build --workspace @platform/web",
    "test": "npm test --workspaces --if-present",
    "lint": "npm run lint --workspace @platform/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check:i18n": "npm run check:i18n --workspace @platform/web"
  }
}
