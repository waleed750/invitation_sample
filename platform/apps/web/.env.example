# Optional public origin for absolute SEO URLs; defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# COMMERCE_MODE=mock
# ALLOW_DEMO_COMMERCE=1

# Better Auth configuration
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_GOOGLE_LOGIN=0
NEXT_PUBLIC_PHONE_LOGIN=0

# COMMERCE_MODE=api needs the NestJS API origin (server-only, no trailing path):
API_BASE_URL=http://localhost:3001
# Guest store backend: demo (file-based) or api (NestJS via API_BASE_URL).
# GUEST_MODE=demo
# HMAC secret (min 32 chars) verifying the API's POST /api/revalidate calls.
# REVALIDATE_SECRET=
