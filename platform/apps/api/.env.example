# Copy to `.env` (never commit real values). Placeholders only.
# The API refuses to boot when a required variable is missing or invalid.

# Port the API listens on.
PORT=3001
# development | production | test
NODE_ENV=development
# Comma-separated list of allowed browser origins (strict CORS — no wildcards).
WEB_ORIGINS=http://localhost:3000,https://example.com

# Supabase project URL + publishable key (safe for server-side use).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Secret. Server only — never returned by any endpoint, never logged.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional. When set, Supabase JWTs are verified locally with HS256.
# When empty, verification uses the project's JWKS endpoint (needs network).
SUPABASE_JWT_SECRET=
# Hard cap (ms) on any single Supabase HTTP call. PostgREST retries are off,
# so an outage degrades to a fast 503 instead of hanging every request.
SUPABASE_TIMEOUT_MS=5000

# Global rate limit: THROTTLE_LIMIT requests per THROTTLE_TTL_MS window per IP.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
# mock | manual | fawry. Implemented: mock (dev only) and manual (admin confirms payments).
# The API refuses to boot with mock (or the not-yet-built fawry) in production.
PAYMENTS_PROVIDER=mock
# Optional (manual provider). Blank = unset. Shown to the customer after checkout, e.g.
# {"methods":[{"id":"instapay","label":{"ar":"إنستاباي","en":"InstaPay"},"details":{"ar":"...","en":"..."}}]}
# id is one of instapay | wallet | bank.
MANUAL_PAYMENT_INSTRUCTIONS_JSON=
# HMAC secret for mock-provider webhook signatures (32+ characters; server only).
PAYMENTS_MOCK_SECRET=replace-with-at-least-32-random-characters
# HMAC secret for guest IP hashing (32+ characters; server only, never returned).
IP_HASH_SECRET=replace-with-another-32-random-characters
# Optional. Blank = revalidation disabled (the API only logs). Web route that refreshes a published page,
# e.g. https://example.com/api/revalidate. Contract: POST JSON {"type":"invitation","slug":"..."} with header
# x-signature = hex HMAC-SHA256 of the raw body keyed with REVALIDATE_SECRET.
WEB_REVALIDATE_URL=
# HMAC secret for that webhook (32+ characters; required when WEB_REVALIDATE_URL is set; server only).
REVALIDATE_SECRET=
# Serve OpenAPI at /docs only when true.
SWAGGER_ENABLED=false
# Daily lifecycle cron (03:00 Africa/Cairo): reminders, end, purge/archive,
# points expiry. Set to false to pause the job without a redeploy.
LIFECYCLE_CRON_ENABLED=true

# Optional. Blank = Sentry disabled. Only 5xx/unhandled errors are reported; bodies and secret headers are never sent.
SENTRY_DSN=
# Optional label for Sentry events (defaults to NODE_ENV).
SENTRY_ENVIRONMENT=

# --- Security (L7) ---
# Real client IP behind a reverse proxy (drives rate limits). Empty/false = use the socket address (direct exposure).
# Values: a hop count (Caddy only -> 1), `loopback`, a comma list of loopback/linklocal/uniquelocal/IPs/CIDRs,
# or `cloudflare` (trust private hops + Cloudflare edges and read CF-Connecting-IP). Never `true`.
TRUST_PROXY=
# Max JSON / urlencoded request body in KB (default 100).
BODY_LIMIT_KB=100
