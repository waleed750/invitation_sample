{
  "name": "@platform/api",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS REST API (v1) for the invitation platform — Auth guard, entitlements slice, OpenAPI.",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "nest start --watch",
    "build": "rm -rf dist tsconfig.build.tsbuildinfo && nest build",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "openapi": "npm run build && node dist/openapi/generate-openapi.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.7.0",
    "@platform/shared": "*",
    "@sentry/nestjs": "^11.4.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "better-auth": "^1.7.7",
    "helmet": "^8.1.0",
    "jose": "^5.9.6",
    "nestjs-pino": "^5.3.1",
    "nestjs-zod": "^5.5.0",
    "nodemailer": "^10.0.16",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.1.0",
    "@types/express": "^4.17.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.15.0",
    "@types/supertest": "^6.0.0",
    "eslint": "^9.39.0",
    "jest": "^29.7.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.1.0",
    "ts-jest": "^29.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
