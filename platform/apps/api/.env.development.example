# Local development and CI only. The API server script overrides DATABASE_URL
# with the password and database selected by scripts/dev-setup.sh.
PORT=3001
NODE_ENV=development
WEB_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://app_api:dev-app-api-password@127.0.0.1:5432/invitations_dev
BETTER_AUTH_SECRET=local-development-secret-replace-before-deploying
BETTER_AUTH_URL=http://localhost:3001
PHONE_LOGIN_ENABLED=false
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=dev
SMTP_PASS=dev
SMTP_FROM=noreply@example.test
EMAIL_SENDER=log
PAYMENTS_PROVIDER=manual
PURCHASES_VIA_BALANCE=true
PAYMENT_EVENTS_ENABLED=false
IP_HASH_SECRET=local-development-ip-hash-secret-replace-before-deploying
MEDIA_STORAGE=local
MEDIA_DIR=./.media-data
MEDIA_SERVE_FROM_API=true
NEXT_PUBLIC_SITE_URL=http://localhost:3000
