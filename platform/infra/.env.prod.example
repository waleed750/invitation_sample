# Production environment template for the compose reference stack.
#
# Usage (on the server, from the repo root):
#   cp platform/infra/.env.prod.example platform/infra/.env.prod
#   nano platform/infra/.env.prod   # fill in REAL secrets
#   docker compose -f platform/infra/docker-compose.prod.yml --env-file platform/infra/.env.prod up -d --build
#
# NEVER commit platform/infra/.env.prod (root .gitignore already ignores it).
# Coolify users: do NOT use this file — paste the same values as Coolify
# environment variables on the api / web resources instead (see DEPLOYMENT.md).

# ---------------------------------------------------------------- domains ---
# Your apex domain (web) and the API subdomain.
DOMAIN=example.com
API_DOMAIN=api.example.com
# Contact for ACME certificate expiry/registration mails (only used in `auto` TLS mode).
ACME_EMAIL=admin@example.com

# ------------------------------------------------------------- TLS at Caddy ---
# auto (default): Caddy provisions/renews PUBLIC ACME certificates itself.
# cloudflare-origin: Caddy serves YOUR Cloudflare Origin CA certificate
# (/etc/caddy/certs/origin.pem + origin-key.pem, from the host dir below).
# Use cloudflare-origin once the firewall admits only Cloudflare
# (CLOUDFLARE_ONLY=1), because ACME HTTP-01 challenges can no longer reach the
# origin then. Safe order: get the site working on `auto` first, install the
# origin cert, switch this to cloudflare-origin, THEN lock the firewall.
CADDY_TLS_MODE=auto
# Host directory holding origin.pem + origin-key.pem (mounted read-only into
# Caddy). Ignored in `auto` mode. Files must be chmod 600; NEVER commit them.
CADDY_ORIGIN_CERTS_DIR=./caddy/certs

# --------------------------------------------------------------- database ---
POSTGRES_USER=postgres
# 32+ random chars: openssl rand -base64 32. The superuser/owner connection
# (used ONLY for migrations via DATABASE_URL_ADMIN) derives from this.
POSTGRES_PASSWORD=replace-with-32-plus-random-characters
POSTGRES_DB=postgres
# App connection (login role app_api, NO password in this file — the password
# is set inside Postgres at deploy time; see DEPLOYMENT.md step 3):
#   postgresql://app_api:<app-api-password>@postgres:5432/postgres
DATABASE_URL=postgresql://app_api:replace-with-the-app-api-password@postgres:5432/postgres

# ------------------------------------------------------------------ API -----
# Mirror of apps/api/.env.example — every API variable lives here in one place
# for the compose stack. Placeholders only; generate secrets with
# `openssl rand -base64 32` (use the full string, 32+ chars).
PORT=3001
NODE_ENV=production
WEB_ORIGINS=https://example.com
# Real client IP, driving API rate limits. `1` = directly behind Caddy only
# (compose default, Cloudflare proxy OFF). `cloudflare` = behind Cloudflare +
# Caddy (trusts private hops + Cloudflare edges, honours CF-Connecting-IP).
# NEVER use `true` (lets any client spoof X-Forwarded-For). Empty = socket
# address (direct exposure, no proxy).
TRUST_PROXY=1
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
BODY_LIMIT_KB=100
# Production MUST use manual (admin confirms each transfer; EasyConfirm
# auto-confirm plug in later via the payment-events endpoint). `mock` and
# `fawry` refuse to boot in production.
PAYMENTS_PROVIDER=manual
# Shown to the customer after checkout, e.g.
# {"methods":[{"id":"instapay","label":{"ar":"...","en":"..."},"details":{"ar":"...","en":"..."}}]}
MANUAL_PAYMENT_INSTRUCTIONS_JSON=
IP_HASH_SECRET=replace-with-at-least-32-random-characters-ip-hash
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters-auth
BETTER_AUTH_URL=https://api.example.com
AUTH_COOKIE_DOMAIN=.example.com
PHONE_LOGIN_ENABLED=false
OTP_DAILY_CAP=500
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: web route that refreshes a published page after payment/order
# events, e.g. https://example.com/api/revalidate. Blank = disabled (logged).
WEB_REVALIDATE_URL=
# 32+ chars; required when WEB_REVALIDATE_URL is set. Must match the web value.
REVALIDATE_SECRET=replace-with-at-least-32-random-characters-revalidate
SWAGGER_ENABLED=false
LIFECYCLE_CRON_ENABLED=true
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# --- Lane L3 (merging soon): leave unset until the payment-events code lands.
# Unset = the inbound webhook adapter stays disabled (fail-closed).
PAYMENT_EVENTS_SECRET=
EASYCONFIRM_API_KEY=
EASYCONFIRM_SIGNATURE_HEADER=x-signature
EASYCONFIRM_TIMESTAMP_HEADER=x-timestamp

# ------------------------------------------------------------------ web -----
# Mirror of apps/web/.env.example (server-side values for the compose stack).
NEXT_PUBLIC_SITE_URL=https://example.com
# Browser → API origin (public).
NEXT_PUBLIC_API_URL=https://api.example.com
# Server → API origin (server-only, no trailing path).
API_BASE_URL=http://api:3001
# Production MUST use api/api (never mock/demo data).
COMMERCE_MODE=api
GUEST_MODE=api
# Must equal the API REVALIDATE_SECRET above.
# (web) REVALIDATE_SECRET=<same-value-as-api>
# Feature flags (1 = on, 0 = off).
NEXT_PUBLIC_GOOGLE_LOGIN=0
NEXT_PUBLIC_PHONE_LOGIN=0
# WhatsApp number in international format (no +), shown on manual-pay pages.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# -------------------------------------------------------------- monitoring --
# Paste from the Beszel hub UI after first start (OPERATIONS.md section 7).
BESZEL_KEY=
BESZEL_HUB_URL=http://beszel-hub:8090
# Paste from the Uptime Kuma push-monitor for backups (alerts if no push > 26h).
KUMA_PUSH_URL=

# ----------------------------------------------------------------- backups --
# Loaded by backup.sh from this same file (or exported in cron/systemd).
POSTGRES_CONTAINER=invitation-platform-prod-postgres-1
BACKUP_DIR=/var/backups/invitation-platform
AGE_PUBLIC_KEY=
RCLONE_REMOTE=s3remote:invitation-backups

# ------------------------------------------- optional admin UIs via Caddy ---
# Default is SSH tunnels (OPERATIONS.md). To expose instead, set ADMIN_DOMAIN,
# create its DNS record, hash a password, and uncomment the admin block + the
# `extra_hosts` lines in docker-compose.prod.yml + caddy/Caddyfile.
ADMIN_DOMAIN=
CADDY_ADMIN_USER=admin
# Generate: docker run --rm caddy:2 caddy hash-password --plaintext '...'
CADDY_ADMIN_HASH=
